# =============================================================================
# Streamlit Cloud Secrets — EXAMPLE FILE
# =============================================================================
# Copy this content into: Streamlit Cloud → App → Settings → Secrets
# DO NOT commit the real secrets.toml — it is already in .gitignore
# =============================================================================

# --- LLM Provider Keys (at least one required) ---
OPENAI_API_KEY = "sk-proj-..."
GOOGLE_API_KEY = "AIza..."
GOOGLE_API_KEY_EMBED = "AIza..."
GROQ_API_KEY = "gsk_..."

# --- HuggingFace (for sentence-transformers / rerankers) ---
HF_TOKEN = "hf_..."

# --- Pinecone Vector Store ---
VECTOR_DB = "pinecone"
PINECONE_API_KEY = "pcsk_..."
PINECONE_INDEX_NAME = "support-sphere-ai"
PINECONE_CLOUD = "aws"
PINECONE_REGION = "us-east-1"

# --- LangSmith Tracing ---
LANGSMITH_TRACING = "true"
LANGSMITH_ENDPOINT = "https://apac.api.smith.langchain.com"
LANGSMITH_API_KEY = "lsv2_pt_..."
LANGSMITH_PROJECT = "support-sphere-ai"
